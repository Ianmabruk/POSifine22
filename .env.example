# Flask Configuration
FLASK_ENV=production

# Database Configuration
DATABASE_URL=postgresql://username:password@host/database?sslmode=require
USE_POSTGRES=true
JWT_SECRET=your_jwt_secret_here
SECRET_KEY=your_flask_secret_here

# Redis Configuration (required for production caching and session store)
# ALL 3 servers (AUTH-1, API-1, API-2) MUST point to the SAME Redis instance
# so rate-limit counters, revoked tokens, session cache and product/dashboard
# caches are shared across the cluster. Omit/leave empty to use an in-memory
# fallback (single-node accounting only - NOT shared across servers).
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=3
REDIS_CONNECT_TIMEOUT=3
# Seconds a revoked JWT jti is retained in Redis (default: 8 days).
JWT_REVOKED_TTL_SECONDS=691200

# Main Admin (Owner)
MAIN_ADMIN_EMAIL=owner@example.com
MAIN_ADMIN_PASSWORD=change_me
