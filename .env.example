# OpenAI / Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Configuration
FLASK_ENV=production

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost/universal_pos
USE_POSTGRES=true
JWT_SECRET=your_jwt_secret_here
SECRET_KEY=your_flask_secret_here

# Redis Configuration (required for production caching and session store)
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1

# Main Admin (Owner)
MAIN_ADMIN_EMAIL=owner@example.com
MAIN_ADMIN_PASSWORD=change_me
