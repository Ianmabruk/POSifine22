[Unit]
Description=Universal POS Backend (Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/home/ian-mabruk/universal
Environment="DATABASE_URL=postgresql://user:pass@localhost:5432/universal"
Environment="REDIS_URL=redis://localhost:6379/0"
Environment="MAIN_ADMIN_EMAIL=admin@example.com"
Environment="MAIN_ADMIN_HASH=$2b$12$replace_with_bcrypt_hash"
Environment="BACKUP_ENCRYPTION_KEY=replace_with_fernet_key"
Environment="ENFORCE_HTTPS=1"
ExecStart=/usr/bin/gunicorn -w 4 -k gthread -b 0.0.0.0:5000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
