// Prisma Schema for POSify Enterprise
// Single datasource configuration (PostgreSQL/MySQL/SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  MAIN_ADMIN
  ADMIN
  CASHIER
}

enum UserStatus {
  ACTIVE
  LOCKED
  SUSPENDED
}

enum Plan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
  TRIAL
}

enum SubscriptionStatus {
  ACTIVE_TRIAL
  TRIAL_EXPIRED
  PENDING_PAYMENT
  ACTIVE_SUBSCRIPTION
  SUSPENDED
  CANCELED
  PAST_DUE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
  CONFLICT
}

enum Operation {
  UPSERT
  DELETE
}

enum ActivityType {
  LOGIN
  LOGOUT
  SALE
  STOCK_UPDATE
  ADMIN_ACTION
  CONFLICT
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_APPROVED
  SUBSCRIPTION_REJECTED
  SUBSCRIPTION_SUSPENDED
  SUBSCRIPTION_REACTIVATED
  TRIAL_STARTED
  TRIAL_EXPIRED
  TRIAL_EXTENDED
  PAYMENT_SUBMITTED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED
  CASHIER_ACTION
  SETTINGS_CHANGED
  PASSWORD_RESET
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
  BANK_TRANSFER
  PAYPAL
  CREDIT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIAL
}

enum TrialStatus {
  ACTIVE
  EXPIRED
  EXTENDED
  CONVERTED
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
  LOCKED
  SUSPENDED
  TRIAL
}

// ============================================================
// CORE MODELS
// ============================================================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(CASHIER)
  status       UserStatus @default(ACTIVE)
  pin          String?
  cashierPin   String?
  screenLocked Boolean    @default(false)
  hourlyRate   Float      @default(0)
  businessType String?
  businessRole String?
  deviceMode   String?
  permissions  Json?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  version      Int        @default(1)
  syncStatus   SyncStatus @default(PENDING)
  origin       String     @default("LOCAL")

  // Relations
  accountId        String
  account          Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdById      String?
  createdBy        User?           @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers     User[]          @relation("UserCreatedBy")
  sessions         Session[]
  timeEntries      TimeEntry[]
  creditRequests   CreditRequest[] @relation("CreditRequestCashier")
  reviewedCredits  CreditRequest[] @relation("CreditRequestReviewer")
  remindersSeen    Reminder[]      @relation("ReminderSeenBy")
  productsCreated  Product[]       @relation("ProductCreatedBy")
  priceChanges     PriceHistory[]  @relation("PriceChangedBy")
  sales            Sale[]          @relation("SaleCashier")
  stockMovements   StockMovement[] @relation("StockMovementCreatedBy")
  remindersCreated Reminder[]      @relation("ReminderCreatedBy")
  expensesCreated  Expense[]       @relation("ExpenseCreatedBy")
  auditLogs        AuditLog[]      @relation("UserAuditLogs")

  @@index([accountId])
  @@index([email])
  @@index([role])
  @@index([status])
}

model Session {
  id               String     @id @default(uuid())
  userId           String
  deviceId         String
  refreshTokenHash String
  ip               String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime   @default(now())
  version          Int        @default(1)
  syncStatus       SyncStatus @default(PENDING)
  origin           String     @default("LOCAL")
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deviceId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Account {
  id                 String             @id @default(uuid())
  ownerEmail         String             @unique
  businessName       String
  plan               Plan               @default(TRIAL)
  subscriptionStatus SubscriptionStatus @default(ACTIVE_TRIAL)
  isActive           Boolean            @default(true)
  isLocked           Boolean            @default(false)
  status             BusinessStatus     @default(TRIAL)

  // Trial fields
  trialStartedAt       DateTime?
  trialEndsAt          DateTime?
  trialStatus          TrialStatus @default(ACTIVE)
  trialExtendedAt      DateTime?
  trialExtendedBy      String?
  trialExtensionReason String?

  // Subscription fields
  subscriptionStartedAt DateTime?
  subscriptionEndsAt    DateTime?
  subscriptionPlan      Plan?
  paymentStatus         PaymentStatus @default(PENDING)

  // Business settings
  businessLogo       String?
  currency           String  @default("KES")
  taxRate            Float   @default(0.0)
  screenLockPassword String  @default("2005")
  industry           String?
  address            String?
  phone              String?
  website            String?

  // Metadata
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  version    Int        @default(1)
  syncStatus SyncStatus @default(PENDING)
  origin     String     @default("LOCAL")

  // Relations
  users            User[]
  products         Product[]
  sales            Sale[]
  stockMovements   StockMovement[]
  timeEntries      TimeEntry[]
  reminders        Reminder[]
  vendors          Vendor[]
  creditRequests   CreditRequest[]
  expenses         Expense[]
  discounts        Discount[]
  serviceFees      ServiceFee[]
  subscriptions    Subscription[]
  payments         Payment[]
  auditLogs        AuditLog[]
  businessProfiles BusinessProfile[]
  trial            Trial?

  @@index([ownerEmail])
  @@index([plan])
  @@index([subscriptionStatus])
  @@index([status])
  @@index([trialEndsAt])
  @@index([subscriptionEndsAt])
}

model BusinessProfile {
  id           String   @id @default(uuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  businessType String
  settings     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([accountId, businessType])
  @@index([accountId])
}

// ============================================================
// SUBSCRIPTION & PAYMENT MODELS
// ============================================================

model SubscriptionPlan {
  id           String  @id @default(uuid())
  name         String  @unique
  displayName  String
  description  String?
  priceMonthly Float
  priceYearly  Float?
  currency     String  @default("KES")

  // Features
  maxBranches          Int     @default(1)
  maxCashiers          Int     @default(2)
  maxProducts          Int     @default(-1) // -1 = unlimited
  hasAnalytics         Boolean @default(false)
  hasReports           Boolean @default(false)
  hasCustomerTracking  Boolean @default(false)
  hasStaffManagement   Boolean @default(false)
  hasApiAccess         Boolean @default(false)
  hasPrioritySupport   Boolean @default(false)
  hasMultiLocation     Boolean @default(false)
  hasAdvancedAnalytics Boolean @default(false)

  // Metadata
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([isActive, sortOrder])
}

model Subscription {
  id        String             @id @default(uuid())
  accountId String
  account   Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  planId    String
  plan      SubscriptionPlan   @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(ACTIVE_TRIAL)

  // Trial
  trialStartedAt DateTime?
  trialEndsAt    DateTime?

  // Subscription
  startedAt    DateTime?
  endsAt       DateTime?
  billingCycle String    @default("monthly") // monthly, yearly
  amount       Float
  currency     String    @default("KES")

  // Payment tracking
  lastPaymentAt      DateTime?
  nextPaymentAt      DateTime?
  failedPaymentCount Int       @default(0)

  // Metadata
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  version    Int        @default(1)
  syncStatus SyncStatus @default(PENDING)
  origin     String     @default("LOCAL")

  payments Payment[]

  @@index([accountId])
  @@index([planId])
  @@index([status])
  @@index([trialEndsAt])
  @@index([endsAt])
}

model Payment {
  id             String        @id @default(uuid())
  accountId      String
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  // Payment details
  amount           Float
  currency         String        @default("KES")
  paymentMethod    PaymentMethod
  paymentReference String        @unique
  paymentStatus    PaymentStatus @default(PENDING)

  // Payer info
  payerName    String
  payerEmail   String
  payerPhone   String?
  businessName String
  selectedPlan String

  // Admin approval
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?

  // Metadata
  notes      String?
  metadata   Json?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  version    Int        @default(1)
  syncStatus SyncStatus @default(PENDING)
  origin     String     @default("LOCAL")

  @@index([accountId])
  @@index([subscriptionId])
  @@index([paymentStatus])
  @@index([paymentReference])
  @@index([createdAt])
  @@index([approvedAt])
}

model Trial {
  id              String      @id @default(uuid())
  accountId       String      @unique
  account         Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status          TrialStatus @default(ACTIVE)
  plan            Plan
  startedAt       DateTime    @default(now())
  endsAt          DateTime
  extendedAt      DateTime?
  extendedBy      String?
  extensionReason String?
  convertedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@index([endsAt])
  @@index([accountId])
}

// ============================================================
// PRODUCT & INVENTORY MODELS
// ============================================================

model Product {
  id                  String        @id @default(uuid())
  accountId           String
  account             Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sku                 String
  name                String
  category            String?       @default("general")
  costPrice           Decimal       @db.Decimal(10, 2)
  sellingPrice        Decimal       @db.Decimal(10, 2)
  quantity            Int           @default(0)
  unit                String        @default("pcs")
  productType         String        @default("regular") // regular, raw, composite, expense
  status              ProductStatus @default(ACTIVE)
  image               String?
  barcode             String?
  reorderLevel        Int           @default(0)
  maxStockLevel       Int           @default(0)
  costPerUnit         Decimal?      @db.Decimal(10, 2)
  enableWeightPricing Boolean       @default(false)
  recipe              Json? // For composite products
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  version             Int           @default(1)
  createdById         String?
  createdBy           User?         @relation("ProductCreatedBy", fields: [createdById], references: [id])
  syncStatus          SyncStatus    @default(PENDING)
  origin              String        @default("LOCAL")

  saleItems      SaleItem[]
  stockMovements StockMovement[]
  discounts      Discount[]
  priceHistory   PriceHistory[]
  linkedExpenses Expense[]       @relation("ExpenseLinkedProduct")

  @@unique([accountId, sku])
  @@index([accountId])
  @@index([category])
  @@index([status])
  @@index([barcode])
  @@index([sku])
}

model PriceHistory {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPrice        Decimal  @db.Decimal(10, 2)
  newPrice        Decimal  @db.Decimal(10, 2)
  changedByUserId String?
  changedBy       User?    @relation("PriceChangedBy", fields: [changedByUserId], references: [id])
  reason          String?
  createdAt       DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

// ============================================================
// SALES MODELS
// ============================================================

model Sale {
  id             String        @id @default(uuid())
  accountId      String
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactionId  String        @unique
  cashierId      String
  cashier        User          @relation("SaleCashier", fields: [cashierId], references: [id])
  subtotal       Decimal       @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  totalCost      Decimal       @db.Decimal(10, 2)
  grossProfit    Decimal       @db.Decimal(10, 2)
  taxAmount      Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @db.Decimal(10, 2)
  serviceFee     Decimal       @db.Decimal(10, 2)
  paymentMethod  PaymentMethod @default(CASH)
  amountPaid     Decimal       @db.Decimal(10, 2)
  change         Decimal       @db.Decimal(10, 2)
  committed      Boolean       @default(true)
  receiptNumber  String?
  notes          String?
  createdAt      DateTime      @default(now())
  version        Int           @default(1)
  syncStatus     SyncStatus    @default(PENDING)
  origin         String        @default("LOCAL")

  items SaleItem[]

  @@index([accountId])
  @@index([cashierId])
  @@index([createdAt])
  @@index([transactionId])
}

model SaleItem {
  id          String  @id @default(uuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  quantity    Float
  unitPrice   Decimal @db.Decimal(10, 2)
  cost        Decimal @db.Decimal(10, 2)
  lineTotal   Decimal @db.Decimal(10, 2)
  unit        String  @default("pcs")

  @@index([saleId])
  @@index([productId])
}

// ============================================================
// INVENTORY TRACKING
// ============================================================

model StockMovement {
  id            String     @id @default(uuid())
  accountId     String
  account       Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId     String
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Float
  movementType  String // 'in', 'out', 'adjustment', 'sale', 'production', 'return'
  referenceId   String?
  referenceType String? // 'sale', 'purchase', 'adjustment', 'production'
  notes         String?
  createdAt     DateTime   @default(now())
  createdById   String?
  createdBy     User?      @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  version       Int        @default(1)
  syncStatus    SyncStatus @default(PENDING)
  origin        String     @default("LOCAL")

  @@index([accountId])
  @@index([productId])
  @@index([movementType])
  @@index([createdAt])
  @@index([referenceId, referenceType])
}

// ============================================================
// TIME TRACKING
// ============================================================

model TimeEntry {
  id              String     @id @default(uuid())
  accountId       String
  account         Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName        String
  clockInTime     DateTime
  clockOutTime    DateTime?
  durationMinutes Int        @default(0)
  date            DateTime   @db.Date
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  version         Int        @default(1)
  syncStatus      SyncStatus @default(PENDING)
  origin          String     @default("LOCAL")

  @@index([accountId])
  @@index([userId])
  @@index([date])
  @@index([userId, date])
}

// ============================================================
// REMINDERS
// ============================================================

model Reminder {
  id          String     @id @default(uuid())
  accountId   String
  account     Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title       String
  message     String
  createdById String
  createdBy   User       @relation("ReminderCreatedBy", fields: [createdById], references: [id])
  seenBy      User[]     @relation("ReminderSeenBy")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  version     Int        @default(1)
  syncStatus  SyncStatus @default(PENDING)
  origin      String     @default("LOCAL")

  @@index([accountId])
  @@index([createdById])
}

// ============================================================
// VENDORS
// ============================================================

model Vendor {
  id               String     @id @default(uuid())
  accountId        String
  account          Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name             String
  productOrService String
  email            String?
  phone            String?
  address          String?
  city             String?
  country          String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  version          Int        @default(1)
  syncStatus       SyncStatus @default(PENDING)
  origin           String     @default("LOCAL")

  @@index([accountId])
  @@index([name])
}

// ============================================================
// CREDIT REQUESTS
// ============================================================

model CreditRequest {
  id           String     @id @default(uuid())
  accountId    String
  account      Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cashierId    String
  cashier      User       @relation("CreditRequestCashier", fields: [cashierId], references: [id])
  cashierName  String
  amount       Float
  reason       String
  status       String     @default("pending") // pending, approved, rejected
  reviewedById String?
  reviewedBy   User?      @relation("CreditRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  adminNotes   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  version      Int        @default(1)
  syncStatus   SyncStatus @default(PENDING)
  origin       String     @default("LOCAL")

  @@index([accountId])
  @@index([cashierId])
  @@index([status])
}

// ============================================================
// EXPENSES
// ============================================================

model Expense {
  id              String     @id @default(uuid())
  accountId       String
  account         Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name            String
  amount          Float
  quantity        Float      @default(1.0)
  unit            String     @default("unit")
  category        String     @default("general")
  description     String?
  source          String     @default("manual") // manual, auto-deduction
  linkedProductId String?
  linkedProduct   Product?   @relation("ExpenseLinkedProduct", fields: [linkedProductId], references: [id])
  createdAt       DateTime   @default(now())
  createdById     String?
  createdBy       User?      @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  version         Int        @default(1)
  syncStatus      SyncStatus @default(PENDING)
  origin          String     @default("LOCAL")

  @@index([accountId])
  @@index([category])
  @@index([createdAt])
}

// ============================================================
// DISCOUNTS & SERVICE FEES
// ============================================================

model Discount {
  id            String     @id @default(uuid())
  accountId     String
  account       Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId     String
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountType  String     @default("percentage") // percentage, fixed
  discountValue Float      @default(0.0)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  version       Int        @default(1)
  syncStatus    SyncStatus @default(PENDING)
  origin        String     @default("LOCAL")

  @@index([accountId])
  @@index([productId])
  @@index([isActive])
}

model ServiceFee {
  id         String     @id @default(uuid())
  accountId  String
  account    Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name       String
  amount     Float
  feeType    String     @default("fixed") // fixed, percentage
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  version    Int        @default(1)
  syncStatus SyncStatus @default(PENDING)
  origin     String     @default("LOCAL")

  @@index([accountId])
  @@index([isActive])
}

// ============================================================
// AUDIT LOGS
// ============================================================

model AuditLog {
  id         String       @id @default(uuid())
  accountId  String?
  account    Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?        @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  type       ActivityType
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime     @default(now())

  @@index([accountId])
  @@index([userId])
  @@index([type])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================
// SYNC QUEUE
// ============================================================

model SyncQueue {
  id            String    @id @default(uuid())
  entityType    String
  entityId      String
  operation     Operation
  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?
  error         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([entityType, entityId])
  @@index([attemptCount])
  @@index([createdAt])
}

// ============================================================
// DEVICE STATE
// ============================================================

model DeviceState {
  id             String   @id @default(uuid())
  deviceId       String   @unique
  lastSyncCursor BigInt   @default(0)
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([deviceId])
}

// ============================================================
// SUPER ADMIN / MAIN ADMIN
// ============================================================

model MainAdmin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Password reset
  resetToken       String?
  resetTokenExpiry DateTime?

  @@index([email])
  @@index([resetToken])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String    @id @default(uuid())
  accountId String?
  userId    String?
  type      String // info, warning, error, success, subscription, trial, payment
  title     String
  message   String
  isRead    Boolean   @default(false)
  metadata  Json?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([accountId])
  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}
